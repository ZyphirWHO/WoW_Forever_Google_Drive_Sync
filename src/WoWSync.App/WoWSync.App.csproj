<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>WoWSync</AssemblyName>
    <RootNamespace>WoWSync.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- File version info shown in Explorer and read by antivirus engines. -->
    <AssemblyTitle>WoWSync - keeps WoW settings in step between your PCs</AssemblyTitle>
    <Description>Keeps World of Warcraft account settings in step between your PCs through your own Google Drive.</Description>
    <!-- Publishing: one self-contained exe, no trimming, no compression (see .github/workflows). -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!--
    The Windows desktop runtime pack also carries WPF's native DLLs, which a single-file publish leaves
    beside the exe. WoWSync is WinForms only and never loads them, so keep them out: the download is
    one WoWSync.exe.
  -->
  <Target Name="ExcludeWpfNativeFiles" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'%(Filename)' == 'D3DCompiler_47_cor3' Or '%(Filename)' == 'PenImc_cor3' Or '%(Filename)' == 'PresentationNative_cor3' Or '%(Filename)' == 'vcruntime140_cor3' Or '%(Filename)' == 'wpfgfx_cor3'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="WoWSync.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WoWSync.Core\WoWSync.Core.csproj" />
  </ItemGroup>

</Project>
