<Project>
  <!--
    Single source of truth for the product name. Everything else (exe name, file version info, cloud and
    local folder names, Start menu and startup entry names, log file prefix, window titles) is derived from
    these two values, in MSBuild here and at run time via InterfaceSync.Core.ProductInfo. CI fails if the
    published exe's ProductName differs from ProductDisplayName.
  -->
  <PropertyGroup>
    <ProductDisplayName>Interface Sync</ProductDisplayName>
    <ProductId>InterfaceSync</ProductId>
    <!-- macOS bundle identifier (reverse-DNS of the project's home). -->
    <ProductBundleId>io.github.zyphirwho.interfacesync</ProductBundleId>
    <!-- GitHub owner/repo whose Releases the app checks for updates (GitHub redirects it if the repo is renamed). -->
    <ProductRepository>ZyphirWHO/WoW_Forever_Google_Drive_Sync</ProductRepository>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Release version. CI development builds carry "-dev.<run>" in their informational version, so any real
         release of this version counts as newer for the updater. -->
    <Version>3.0.0</Version>
    <Product>$(ProductDisplayName)</Product>
    <Description>$(ProductDisplayName)</Description>
    <Company>$(ProductDisplayName) contributors</Company>
    <Copyright>Copyright (c) 2026 $(ProductDisplayName) contributors. MIT License.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="ProductId" Value="$(ProductId)" />
    <AssemblyMetadata Include="ProductBundleId" Value="$(ProductBundleId)" />
    <AssemblyMetadata Include="ProductRepository" Value="$(ProductRepository)" />
  </ItemGroup>
</Project>
