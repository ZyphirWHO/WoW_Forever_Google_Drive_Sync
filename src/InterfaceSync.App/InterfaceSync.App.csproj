<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>$(ProductId)</AssemblyName>
    <RootNamespace>InterfaceSync.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Generated from assets/icon/app.svg by assets/icon/generate.py -->
    <ApplicationIcon>Icons\app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- File version info shown in Explorer and read by antivirus engines. -->
    <AssemblyTitle>$(ProductDisplayName)</AssemblyTitle>
    <!-- Publishing: one self-contained exe, no trimming, no compression (see .github/workflows). -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!--
    The Windows desktop runtime pack also carries WPF's native DLLs, which a single-file publish leaves
    beside the exe. InterfaceSync is WinForms only and never loads them, so keep them out: the download is
    one InterfaceSync.exe.
  -->
  <Target Name="ExcludeWpfNativeFiles" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'%(Filename)' == 'D3DCompiler_47_cor3' Or '%(Filename)' == 'PenImc_cor3' Or '%(Filename)' == 'PresentationNative_cor3' Or '%(Filename)' == 'vcruntime140_cor3' Or '%(Filename)' == 'wpfgfx_cor3'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="Icons\*.ico" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="Icons\crest.png" LogicalName="crest.png" />
    <EmbeddedResource Include="..\..\assets\fonts\Cinzel-Bold.ttf" LogicalName="Cinzel-Bold.ttf" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="InterfaceSync.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InterfaceSync.Core\InterfaceSync.Core.csproj" />
  </ItemGroup>

</Project>
